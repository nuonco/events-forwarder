# DataDog API credentials
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here

# Grafana Cloud credentials
GRAFANA_METRICS_URL=https://prometheus-prod-xx-prod-region.grafana.net/api/prom/push
GRAFANA_INSTANCE_ID=your_instance_id_here
GRAFANA_API_TOKEN=your_grafana_api_token_here

# Nuon webhook verification secret
NUON_WEBHOOK_SECRET=your_webhook_secret_here
