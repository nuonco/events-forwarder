# Nuon Webhook Configuration
NUON_WEBHOOK_SECRET=your-webhook-secret-here

# OpenTelemetry Collector Configuration
# Local dev: http://localhost:4318
# Docker Compose: http://otel-collector:4318
OTEL_COLLECTOR_ENDPOINT=GRAFANA_LOKI_URL=logs-prod-XXX.grafana.net

# App Settings
PORT=8080
LOG_LEVEL=INFO

# DataDog Credentials (used by OTel Collector)
# Only needed if running the OTel Collector locally
DATADOG_API_KEY=your-datadog-api-key

# Grafana Loki Credentials (used by OTel Collector)
# Only needed if running the OTel Collector locally
GRAFANA_LOKI_URL=your-grafana-loki-url
GRAFANA_LOKI_INSTANCE_ID=your-grafana-instance-id
GRAFANA_LOKI_TOKEN=your-grafana-loki-token
